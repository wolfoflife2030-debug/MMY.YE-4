{
  "name": "mmy-media-platform",
  "version": "1.2.0",
  "description": "MMY.YE — لوحة إدارة المراكز والكادر الإعلامي",
  "main": "electron/main.js",
  "author": "MMY.YE",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "icons": "python3 scripts/make_icons.py assets/windows-icon.png assets/android-logo.png build && cp build/logo.webp www/logo.webp"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ye.mmy.platform",
    "productName": "MMY.YE",
    "copyright": "MMY.YE",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MMY.YE"
    }
  }
}
